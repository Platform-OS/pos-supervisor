{% doc %}
  @param object {object} - record data or command result with errors
{% enddoc %}

{% liquid
  if object.id
    assign method = 'put'
  else
    assign method = 'post'
  endif
%}

<form action="/events" method="post" class="pos-form pos-form-simple">
  <input type="hidden" name="authenticity_token" value="{{ context.authenticity_token }}">
  <input type="hidden" name="_method" value="{{ method }}">

  {% if object.id %}
    <input type="hidden" name="event[id]" value="{{ object.id }}">
  {% endif %}

  {% render 'modules/common-styling/forms/error_list', errors: object.errors, name: 'form' %}

  <fieldset>
    <label for="name">{{ 'app.events.attr.name' | t }}</label>
    <input type="text" name="event[name]" id="name" value="{{ object.name }}" {% render 'modules/common-styling/forms/error_input_handler', errors: object.errors.name, name: 'name' %}>
    {% render 'modules/common-styling/forms/error_list', errors: object.errors.name, name: 'name' %}
  </fieldset>

  <fieldset>
    <label for="date">{{ 'app.events.attr.date' | t }}</label>
    <input type="text" name="event[date]" id="date" value="{{ object.date }}" {% render 'modules/common-styling/forms/error_input_handler', errors: object.errors.date, name: 'date' %}>
    {% render 'modules/common-styling/forms/error_list', errors: object.errors.date, name: 'date' %}
  </fieldset>

  <fieldset>
    <label for="capacity">{{ 'app.events.attr.capacity' | t }}</label>
    <input type="number" name="event[capacity]" id="capacity" value="{{ object.capacity }}" {% render 'modules/common-styling/forms/error_input_handler', errors: object.errors.capacity, name: 'capacity' %}>
    {% render 'modules/common-styling/forms/error_list', errors: object.errors.capacity, name: 'capacity' %}
  </fieldset>

  <fieldset class="pos-form-actions">
    <button type="submit" class="pos-button pos-button-primary">{{ 'app.events.save' | t }}</button>
    <a href="/events">{{ 'app.events.cancel' | t }}</a>
  </fieldset>
</form>
