{% doc %}
  @param object {object} - events record
{% enddoc %}

<article>
  <h1 class="pos-heading-1">{{ object.name }}</h1>

  <dl style="margin-block-start:var(--pos-gap-section-section);">
  <dt class="pos-supplementary">{{ 'app.events.attr.date' | t }}</dt>
  <dd>{{ object.date }}</dd>

  <dt class="pos-supplementary">{{ 'app.events.attr.capacity' | t }}</dt>
  <dd>{{ object.capacity }}</dd>
  </dl>
</article>
